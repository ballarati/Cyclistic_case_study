SELECT
  member_casual,
  COUNT(*) AS total_rides_by_type,
  ROUND(COUNT(*) / (
    SELECT
      COUNT(*)
    FROM
      # for query other dataset, change 202505 to the appropriate table name
      `learning-bigquery-481810.cyclistic.202505-divvy-tripdata`
  ), 2) AS type_ratio
FROM
  # for query other dataset, change 202505 to the appropriate table name
  `learning-bigquery-481810.cyclistic.202505-divvy-tripdata`
GROUP BY
  member_casual
ORDER BY
  member_casual ASC
