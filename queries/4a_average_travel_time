###########################################################
## Queries May 2025 dataset.                             ##
## To query other dataset change '202505' to appropriate ##
## date in the tables.                                   ##
###########################################################
SELECT
  member_casual,
  AVG(travel_time_min) AS avg,
  (
    SELECT
      AVG(travel_time_min)
    FROM
      `learning-bigquery-481810.cyclistic.202505-divvy-tripdata`
  ) AS avg_total,
FROM
  `learning-bigquery-481810.cyclistic.202505-divvy-tripdata`
GROUP BY
  member_casual
ORDER BY
  member_casual ASC
